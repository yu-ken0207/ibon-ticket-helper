{
  "manifest_version": 3,
  "name": "一般票券訂票助手",
  "version": "0.2.0",
  "description": "一般票券的購票輔助：照你的偏好選時段與張數、填你提供的購票人資料，停在確認頁由你自己確認。遇到排隊、驗證碼、機器人檢查一律停下來交給你。目前只支援本機的一般票券模擬站。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "一般票券訂票助手",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/pool/*", "http://localhost/pool/*"],
      "js": ["agent.js"],
      "run_at": "document_end",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png" }
}
